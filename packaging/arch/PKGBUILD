# Maintainer: Official Husko <https://github.com/Official-Husko>
pkgname=f95-notify-git
_pkgname=f95-notify
pkgver=2.0.0
pkgrel=1
pkgdesc="Desktop notifications for F95Zone alerts (native KDE tray and notifications)"
arch=('x86_64' 'aarch64')
url="https://github.com/Official-Husko/f95-notify"
license=('GPL-2.0-only')
depends=('gcc-libs' 'glibc' 'webkit2gtk-4.1' 'gtk3')
optdepends=('xdg-utils: open alerts in the default browser')
makedepends=('cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "%s.r%s.g%s" "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/f95-notify target/release/f95-notify-login -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/f95-notify.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/f95-notify.png"
}
